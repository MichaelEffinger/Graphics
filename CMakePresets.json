{
    "version": 3,

    "configurePresets": [
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${presetName}",
            "installDir": "${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_TOOLCHAIN_FILE": "$env{ES_VCPKG_PATH}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },

        {
            "name": "linux-clang-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${presetName}",
            "installDir": "${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "$env{ES_VCPKG_PATH}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },

        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "inherits": "linux-base",
            "architecture": {
                "value": "x86_64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ES_USE_STDCXXEXP": "ON"
            }
        },

        {
            "name": "clang-x64-debug",
            "displayName": "Clang x64 Debug",
            "inherits": "linux-clang-base",
            "architecture": {
                "value": "x86_64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ES_USE_STDCXXEXP": "ON"
            }
        },

        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "inherits": "x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },

        {
            "name": "msvc-x64-debug",
            "displayName": "MSVC x64 Debug",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${presetName}",
            "installDir": "${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{ES_VCPKG_PATH}",
                "ES_USE_STDCXXEXP": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },

        {
            "name": "ci-gcc-x64-debug",
            "displayName": "CI GCC x64 Debug",
            "inherits": "x64-debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc-15",
                "CMAKE_CXX_COMPILER": "g++-15"
            }
        },

        {
            "name": "ci-clang-x64-debug",
            "displayName": "CI Clang x64 Debug",
            "inherits": "clang-x64-debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-22",
                "CMAKE_CXX_COMPILER": "clang++-22"
            }
        },

        {
            "name": "ci-clang-libcxx-x64-debug",
            "displayName": "CI Clang libc++ x64 Debug",
            "inherits": "clang-x64-debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-22",
                "CMAKE_CXX_COMPILER": "clang++-22",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++",
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
                "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++",
                "VCPKG_TARGET_TRIPLET": "x64-linux-libcxx",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
            },
            "environment": {
            "CC": "clang-22",
            "CXX": "clang++-22"
            }
        }, 

        {
            "name": "ci-msvc-x64-debug",
            "displayName": "CI MSVC x64 Debug (Ninja)",
            "generator": "Ninja",
            "binaryDir": "${presetName}",
            "installDir": "${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{ES_VCPKG_PATH}",
                "ES_USE_STDCXXEXP": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
            



    ]
}
